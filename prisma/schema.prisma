generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum Category {
  CEMENT
  STEEL
}

enum OrderStatus {
  NEW
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  phone        String?
  password     String
  role         Role           @default(CUSTOMER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  priceHistory PriceHistory[]
}

model Product {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String?
  category     Category
  brand        String
  variant      String?
  price        Decimal        @db.Decimal(10, 2)
  unit         String
  stock        Int            @default(0)
  minimumStock Int            @default(10)
  image        String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  orderItems   OrderItem[]
  priceHistory PriceHistory[]
}

model Order {
  id                     String      @id @default(cuid())
  orderNumber            String      @unique
  customerName           String
  phone                  String
  whatsapp               String?
  deliveryAddress        String
  houseNumber            String?
  street                 String?
  area                   String?
  city                   String
  district               String?
  state                  String
  pincode                String
  additionalInstructions String?
  subtotal               Decimal     @db.Decimal(10, 2)
  deliveryCharge         Decimal     @db.Decimal(10, 2)
  total                  Decimal     @db.Decimal(10, 2)
  status                 OrderStatus @default(NEW)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  items                  OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  brand       String
  variant     String?
  quantity    Int
  unit        String
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  oldPrice  Decimal  @db.Decimal(10, 2)
  newPrice  Decimal  @db.Decimal(10, 2)
  changedBy String
  user      User     @relation(fields: [changedBy], references: [id])
  createdAt DateTime @default(now())
}

model Settings {
  id                String   @id @default(cuid())
  businessName      String   @default("PAVITHRA TRADERS")
  phone             String   @default("9025644746")
  whatsapp          String   @default("9025644746")
  location          String   @default("AAA")
  address           String?
  openingHours      String   @default("Mon–Sat: 8:00 AM – 7:00 PM")
  deliveryCharge    Decimal  @default(200) @db.Decimal(10, 2)
  minimumOrderValue Decimal  @default(0) @db.Decimal(10, 2)
  logo              String?
  updatedAt         DateTime @updatedAt
}
